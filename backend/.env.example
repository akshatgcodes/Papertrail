# Password for the app. Required.
APP_PASSWORD=

# Signs the session cookie. Any long random string.
SESSION_SECRET=

# Where the React app runs (CORS)
FRONTEND_URL=http://localhost:5173

# Language model: groq, openai or ollama (all spoken to through the OpenAI-compatible API).
# Without a key the library and retrieval still work; questions stop before the answer.
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides; each provider has a default
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=
# Output budget per answer (reasoning models think before answering)
LLM_MAX_TOKENS=8000

# Embeddings and re-ranking run locally (fastembed, ONNX); models download on first use
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Retrieval. MIN_SIMILARITY was calibrated for bge-small; see docs/DECISIONS.md before
# changing the embedding model
# MIN_SIMILARITY=0.68
# TOP_K=8
# PER_DOC=3
# CONFLICT_SIMILARITY=0.75
# MAX_CONFLICT_PAIRS=4

# SQLite, the Chroma index and uploaded PDFs live here
DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/papertrail
